  "version": "1.0.0",
  "description": "Teamwork software",
  "homepage": "https://github.com/cse110-sp26-group11/SE-SitRep#readme",
  "bugs": {
    "url": "https://github.com/cse110-sp26-group11/SE-SitRep/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cse110-sp26-group11/SE-SitRep.git"
  },
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "index.html",
  "scripts": {
    "db:create": "wrangler d1 create se-sitrep",
    "db:migrate:local": "wrangler d1 migrations apply se-sitrep --local",
    "db:migrate:remote": "wrangler d1 migrations apply se-sitrep --remote",
    "db:seed:local": "wrangler d1 execute se-sitrep --local --file=./d1/seeds/demo.sql",
    "db:seed:remote": "wrangler d1 execute se-sitrep --remote --file=./d1/seeds/demo.sql",
    "db:console:local": "wrangler d1 execute se-sitrep --local --command=\"SELECT name FROM sqlite_master WHERE type = 'table' ORDER BY name;\"",
    "test": "vitest run"
  },
  "devDependencies": {
    "vitest": "^4.1.7",
    "eslint": "^8.57.1",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-jsdoc": "^48.11.0",
    "htmlhint": "^1.9.2",
    "stylelint": "^17.12.0",
    "stylelint-config-standard": "^40.0.0",
    "wrangler": "^4.95.0"
  }
}
